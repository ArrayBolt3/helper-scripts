#!/bin/bash

## Copyright (C) 2025 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Pack files into a supplementary squashfs image, preserving layout, perms,
## owners and symlinks. Generic utility; primary use is a supplementary overlay
## squashfs that a live installer (Calamares unpackfs) layers on top of the base
## filesystem.squashfs, so file changes reach the INSTALLED system without a
## full image rebuild.
##
## Three sources of content:
##   <path> ...        named absolute paths; their current content is staged
##                     preserving layout, then packed.
##   --from-dir <dir>  a directory mirroring '/' is packed as-is.
##   --from-overlay    the live root's overlayfs upperdir is packed directly, so
##                     any file edited live is captured with no staging step.
##
## --from-overlay is DEVELOPER OPT-IN. The Calamares pre-unpackfs module invokes
## it on every install, but it is a no-op unless the environment variable
## DEVOVERLAY is truthy (1/true/yes), so normal user installs are unaffected. A
## developer exports it before launching the installer AND preserves it across
## the privilege escalation (e.g. 'sudo -E calamares' or
## 'pkexec env DEVOVERLAY=1 calamares'); a plain desktop-icon launch would scrub
## it. --force bypasses the gate for a manual run.
## Behaviour notes: --from-overlay captures ALL live-session upperdir state
## (e.g. /var/log, dpkg state, /etc/machine-id) -- acceptable for development.
## Overlay whiteouts (char 0,0 nodes marking files deleted live) are EXCLUDED
## from the pack: they cannot effect a deletion via rsync anyway, they recreate
## as junk char nodes in the install, and creating one fails on a restrictive
## target filesystem (e.g. a FAT ESP), which can abort the install. So files
## DELETED live are simply not removed from the install.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="${BASH_SOURCE[0]##*/}"

default_output="/run/overlay-squashfs/overlay.squashfs"

usage() {
   cat <<EOF
Usage: ${me} [options] <path> [<path> ...]
       ${me} [options] --from-dir <dir>
       ${me} [options] --from-overlay

Pack files into a squashfs overlay image.

Content source (choose one):
  <path> ...               absolute paths; staged preserving layout, then packed.
  --from-dir <dir>         pack this directory (a changeset root mirroring '/').
  --from-overlay           pack the live root overlayfs upperdir (no staging);
                           developer opt-in via DEVOVERLAY (or --force).

Options:
  --output <path>          output squashfs. Default '${default_output}'.
  --overlay-of <dir>       with --from-overlay, the overlay mount to read.
                           Default '/'.
  --force                  with --from-overlay, ignore the DEVOVERLAY opt-in gate.
  --help                   show this help.
EOF
}

error() {
   printf '%s\n' "${me}: ERROR: $*" >&2
   exit 1
}

## style-ok: no-has
require_cmd() {
   local cmd command_v_output
   for cmd in "$@" ; do
      command_v_output="$(command -v "${cmd}" 2>/dev/null)" || true
      if [ -z "${command_v_output}" ] || ! [ -x "${command_v_output}" ]; then
         error "required command not found: '${cmd}'. Install its Debian package."
      fi
   done
}

## Decode mountinfo octal escapes so a path containing a space/tab/newline/
## backslash compares and resolves correctly. Backslash LAST so a real backslash
## (encoded \134) cannot spuriously form another escape.
mountinfo_unescape() {
   local value
   value="$1"
   value="${value//\\040/ }"
   value="${value//\\011/$'\t'}"
   value="${value//\\012/$'\n'}"
   value="${value//\\134/\\}"
   printf '%s' "${value}"
}

## Resolve the upperdir of the overlay mounted at a given mountpoint, from
## /proc/self/mountinfo. The super options (after the ' - ' separator) carry
## 'upperdir='.
overlay_upperdir_of() {
   local target line pre post fstype opts upper mount_point opt_item
   local -a opt_list
   target="$1"
   upper=""
   while IFS= read -r line ; do
      pre="${line%% - *}"
      post="${line#* - }"
      ## Field 5 of the pre-separator part is the mount point.
      read -r _ _ _ _ mount_point _ <<< "${pre}"
      [ "$(mountinfo_unescape "${mount_point}")" = "${target}" ] || continue
      read -r fstype _ opts <<< "${post}"
      [ "${fstype}" = "overlay" ] || continue
      ## Split options on comma via read (no glob/word-split exposure).
      IFS=',' read -r -a opt_list <<< "${opts}"
      for opt_item in "${opt_list[@]}" ; do
         case "${opt_item}" in
            upperdir=*)
               upper="${opt_item#upperdir=}"
               ;;
         esac
      done
   done < /proc/self/mountinfo
   printf '%s' "$(mountinfo_unescape "${upper}")"
}

## --from-overlay is developer opt-in; enabled only when DEVOVERLAY is truthy.
overlay_pack_enabled() {
   local value
   value="${DEVOVERLAY:-}"
   value="${value,,}"
   case "${value}" in
      ""|0|false|no|off)
         return 1
         ;;
      *)
         return 0
         ;;
   esac
}

from_dir=""
from_overlay="false"
overlay_of="/"
force="false"
output_squashfs="${default_output}"
paths=()

while [ "$#" -gt 0 ] ; do
   case "$1" in
      --from-dir)
         [ "$#" -ge 2 ] || error "--from-dir requires a value"
         case "${2}" in -*) error "--from-dir value must not start with '-'" ;; esac
         from_dir="${2}"
         shift 2
         ;;
      --from-overlay)
         from_overlay="true"
         shift
         ;;
      --overlay-of)
         [ "$#" -ge 2 ] || error "--overlay-of requires a value"
         overlay_of="${2}"
         shift 2
         ;;
      --force)
         force="true"
         shift
         ;;
      --output)
         [ "$#" -ge 2 ] || error "--output requires a value"
         case "${2}" in -*) error "--output value must not start with '-'" ;; esac
         output_squashfs="${2}"
         shift 2
         ;;
      --help)
         usage
         exit 0
         ;;
      --)
         shift
         while [ "$#" -gt 0 ] ; do
            paths+=( "$1" )
            shift
         done
         ;;
      -*)
         error "unknown option: '$1' (see --help)"
         ;;
      *)
         paths+=( "$1" )
         shift
         ;;
   esac
done

## Exactly one content source.
source_count=0
[ "${#paths[@]}" -gt 0 ] && source_count=$(( source_count + 1 ))
[ -n "${from_dir}" ] && source_count=$(( source_count + 1 ))
[ "${from_overlay}" = "true" ] && source_count=$(( source_count + 1 ))
[ "${source_count}" -eq 1 ] || error "choose exactly one of: paths, --from-dir, --from-overlay (see --help)"

## Opt-in gate FIRST, before requiring any tool: a normal install (DEVOVERLAY
## unset) must be a guaranteed no-op that cannot abort the install even if an
## optional tool (safe-rm, squashfs-tools) is absent.
if [ "${from_overlay}" = "true" ] && [ "${force}" != "true" ] && ! overlay_pack_enabled ; then
   printf '%s\n' "${me}: --from-overlay opt-in not set (export DEVOVERLAY=true); skipping." >&2
   exit 0
fi

require_cmd mksquashfs cp safe-rm mkdir chmod realpath find stat

staging=""
whiteout_excludes=""
cleanup() {
   local rc="${1:-$?}"
   if [ -n "${staging}" ] ; then
      safe-rm --recursive --force -- "${staging}" 2>/dev/null || true
   fi
   if [ -n "${whiteout_excludes}" ] ; then
      safe-rm --force -- "${whiteout_excludes}" 2>/dev/null || true
   fi
   trap - EXIT
   exit "${rc}"
}
on_signal() {
   cleanup 143
}
trap cleanup EXIT
trap on_signal INT TERM

if [ "${from_overlay}" = "true" ] ; then
   ## Opt-in already checked above. A non-overlay root is NOT an error: skip
   ## cleanly (exit 0) rather than abort the install.
   pack_root="$(overlay_upperdir_of "${overlay_of}")"
   if [ -z "${pack_root}" ] || [ ! -d "${pack_root}" ] ; then
      printf '%s\n' "${me}: NOTE: '${overlay_of}' has no overlay upperdir; skipping (install unaffected)." >&2
      exit 0
   fi
elif [ -n "${from_dir}" ] ; then
   [ -d "${from_dir}" ] || error "--from-dir is not a directory: '${from_dir}'"
   pack_root="${from_dir}"
else
   staging="$(mktemp --directory)"
   local_path=""
   canon_path=""
   for local_path in "${paths[@]}" ; do
      if [ "${local_path:0:1}" != "/" ] ; then
         error "path must be absolute: '${local_path}'"
      fi
      ## Canonicalize lexically (no symlink following), so '..', '//' and '/.'
      ## cannot smuggle '/' past the guard nor make cp --parents write outside
      ## the staging dir.
      canon_path="$(realpath --canonicalize-missing --no-symlinks -- "${local_path}")"
      if [ "${canon_path}" = "/" ] ; then
         error "refusing to pack '/'"
      fi
      ## Accept a dangling symlink (cp --archive preserves it); -e alone is
      ## false for one.
      if [ ! -e "${canon_path}" ] && [ ! -L "${canon_path}" ] ; then
         error "path does not exist: '${canon_path}'"
      fi
      cp --archive --one-file-system --parents -- "${canon_path}" "${staging}/"
   done
   pack_root="${staging}"
fi

out_dir="$(dirname -- "${output_squashfs}")"
mkdir -p -- "${out_dir}"
if [ -d "${output_squashfs}" ] ; then
   error "output path is an existing directory: '${output_squashfs}'"
fi
safe-rm --force -- "${output_squashfs}"

## Overlayfs whiteouts (char device 0,0) mark files deleted in the live
## session. Once the squashfs is rsynced onto the target there is no overlay, so
## they cannot effect a deletion; rsync recreates them as junk char nodes, and
## creating a device node fails on a restrictive target (e.g. a FAT ESP), which
## can abort the install. Collect them so mksquashfs excludes them. Harmless in
## the other modes: a clean changeset tree has no char 0,0 nodes.
whiteout_excludes="$(mktemp)"
wh_node=""
while IFS= read -r -d '' wh_node ; do
   [ "$(stat --format='%t %T' -- "${wh_node}" 2>/dev/null)" = "0 0" ] || continue
   ## Path relative to the source root, NO leading '/'. mksquashfs -ef in its
   ## default (non-wildcard) mode matches this LITERALLY and root-anchored, so a
   ## filename containing a glob metacharacter cannot mis-match and a same-named
   ## file at another depth is not swept. A leading '/' is instead read as a real
   ## absolute path and silently ignored.
   printf '%s\n' "${wh_node#"${pack_root%/}/"}" >> "${whiteout_excludes}"
done < <(find "${pack_root}" -xdev -type c -print0)

## Overlays are small; xz + reproducible mirrors the main squashfs. mksquashfs
## honors SOURCE_DATE_EPOCH when exported.
## -one-file-system: never cross a mount boundary, so a special filesystem
## (proc/sys/dev) or any nested mount under the packed tree cannot be packed.
## -ef: drop the overlay whiteout nodes collected above.
printf '%s\n' "${me}: packing overlay squashfs -> '${output_squashfs}'" >&2
if ! mksquashfs "${pack_root}" "${output_squashfs}" \
   -reproducible \
   -noappend \
   -comp xz \
   -no-progress \
   -one-file-system \
   -ef "${whiteout_excludes}"
then
   ## Drop any partial image so an optional unpackfs entry skips it cleanly.
   safe-rm --force -- "${output_squashfs}"
   if [ "${from_overlay}" = "true" ] ; then
      printf '%s\n' "${me}: NOTE: overlay pack failed; skipping (install unaffected)." >&2
      exit 0
   fi
   error "mksquashfs failed"
fi

## Restrict the image: it may contain files that were mode 0600 on disk.
chmod 0600 -- "${output_squashfs}"

printf '%s\n' "${me}: done: '${output_squashfs}'" >&2
