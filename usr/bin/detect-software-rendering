#!/bin/bash

## style-ok: no-strict -- dual-mode: strict is set only inside 'if was_executed' (a direct run, so it cannot leak into a shell that sources this file), hence not at column 0.
## Copyright (C) 2020 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## provides was_executed
# shellcheck source=../libexec/helper-scripts/check_runtime.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/check_runtime.bsh
## provides has
# shellcheck source=../libexec/helper-scripts/has.sh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/has.sh

## Dual-mode: this file is also SOURCED (unit tests, or reuse of the
## detect_software_rendering function), so strict mode is enabled on a DIRECT
## run only and cannot leak into the sourcing shell.
if was_executed "${BASH_SOURCE[0]}"; then
   set -o errexit
   set -o nounset
   set -o pipefail
   set -o errtrace
   shopt -s inherit_errexit
   shopt -s shift_verbose
fi

## Best-effort GUESS of the OpenGL renderer type, via 'eglinfo'. This is never
## authoritative: 'eglinfo' can be absent, report nothing, or - on headless VMs
## and Qubes AppVMs with no accelerated GL (no '/dev/dri') - HANG forever on
## EGL/DRM probing. It is therefore always bounded with 'timeout', and anything
## that is not a clear match is reported as 'unknown' rather than assumed.
##
## Prints one of, and returns:
##   software      0   llvmpipe (mesa CPU renderer)
##   accelerated   1   a known hardware vendor renderer
##   unknown       2   eglinfo absent / empty / timed out / unrecognized
##
## Primary consumer: the 'softwarecontext' QMLSCENE_DEVICE fallback in
## vm-config-dist's /etc/profile.d/20_software_rendering_in_vms.sh.
detect_software_rendering() {
   local eglinfo_output renderer_line timeout_maybe

   eglinfo_output=""
   renderer_line=""
   timeout_maybe=""

   if has eglinfo ; then
      ## 'timeout' (coreutils, Essential: yes) bounds eglinfo; empty prefix when
      ## it is somehow absent, in which case eglinfo runs unbounded.
      if has timeout ; then
         timeout_maybe="timeout 5"
      fi
      ## Deliberate word-splitting: 'timeout 5' -> two words, or nothing.
      # shellcheck disable=SC2086
      eglinfo_output="$(${timeout_maybe} eglinfo -B 2>/dev/null)" || true
      renderer_line="$(printf '%s\n' "${eglinfo_output}" | grep -- "OpenGL core profile renderer:")" || true
   fi

   ## Known hardware vendor renderer -> accelerated. Here-string, not a pipe, so
   ## a quiet grep cannot SIGPIPE the producer into a pipefail failure (R-161).
   if grep --quiet --fixed-strings \
      -e "AMD" \
      -e "NVIDIA" \
      -e "Intel" \
      -e "Apple" \
      -e "Adreno" \
      -e "Radeon" \
      -e "ATI" \
      -e "Mali" \
      -e "Panfrost" \
      -e "V3D" \
      -e "VC4" \
      -e "PowerVR" \
      -e "Vivante" \
      -e "etnaviv" \
      -e "Lima" \
      -e "virgl" \
      -e "SVGA3D" \
      -e "D3D12" \
      <<< "${renderer_line}" ; then
      printf '%s\n' "accelerated"
      return 1
   fi

   ## Mesa CPU renderer -> software.
   if grep --quiet -- "llvmpipe" <<< "${renderer_line}" ; then
      printf '%s\n' "software"
      return 0
   fi

   ## No eglinfo, empty output, a timeout, or an unrecognized renderer.
   printf '%s\n' "unknown"
   return 2
}

## Only auto-run when executed, not when sourced (unit tests source it).
if was_executed "${BASH_SOURCE[0]}"; then
   detect_software_rendering "$@" || exit "${?}"
fi
