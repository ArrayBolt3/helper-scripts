#!/bin/bash -e

## Copyright (C) 2020 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## errexit on the shebang (direct run only; ignored when sourced) so a failed
## 'source' below aborts before main() sets the full strict block.

## provides was_executed
# shellcheck source=../libexec/helper-scripts/check_runtime.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/check_runtime.bsh
## provides has
# shellcheck source=../libexec/helper-scripts/has.sh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/has.sh

## Probe 'eglinfo' and classify the OpenGL renderer. Best-effort only: 'eglinfo'
## can be absent, report nothing, or - on headless VMs and Qubes AppVMs with no
## accelerated GL (no '/dev/dri') - HANG forever on EGL/DRM probing, so it is
## always bounded with 'timeout'. Prints exactly one word: accelerated, software
## or unknown. Anything not a clear match is 'unknown', never assumed.
## Pure and strict-mode free (see detect_software_rendering).
probe_renderer() {
   local eglinfo_output renderer_line timeout_maybe

   eglinfo_output=""
   renderer_line=""
   timeout_maybe=""

   if has eglinfo ; then
      ## 'timeout' (coreutils, Essential: yes) bounds eglinfo; empty prefix when
      ## it is somehow absent, in which case eglinfo runs unbounded.
      if has timeout ; then
         timeout_maybe="timeout 5"
      fi
      ## Deliberate word-splitting: 'timeout 5' -> two words, or nothing.
      # shellcheck disable=SC2086
      eglinfo_output="$(${timeout_maybe} eglinfo -B 2>/dev/null)" || true
      renderer_line="$(printf '%s\n' "${eglinfo_output}" | grep -- "OpenGL core profile renderer:")" || true
   fi

   ## Known hardware vendor renderer -> accelerated. Here-string, not a pipe, so
   ## a quiet grep cannot SIGPIPE the producer into a pipefail failure (R-161).
   if grep --quiet --fixed-strings \
      -e "AMD" \
      -e "NVIDIA" \
      -e "Intel" \
      -e "Apple" \
      -e "Adreno" \
      -e "Radeon" \
      -e "ATI" \
      -e "Mali" \
      -e "Panfrost" \
      -e "V3D" \
      -e "VC4" \
      -e "PowerVR" \
      -e "Vivante" \
      -e "etnaviv" \
      -e "Lima" \
      -e "virgl" \
      -e "SVGA3D" \
      -e "D3D12" \
      <<< "${renderer_line}" ; then
      printf '%s\n' "accelerated"
      return 0
   fi

   if grep --quiet -- "llvmpipe" <<< "${renderer_line}" ; then
      printf '%s\n' "software"
      return 0
   fi

   printf '%s\n' "unknown"
}

## Best-effort GUESS of the renderer type. Prints one of, and returns:
##   software      0   llvmpipe (mesa CPU renderer)
##   accelerated   1   a known hardware vendor renderer
##   unknown       2   eglinfo absent / empty / timed out / unrecognized
##
## The renderer is a per-boot property, and probe_renderer can cost the full
## 'timeout' on a headless VM, so the result is cached in XDG_RUNTIME_DIR (a
## per-boot tmpfs): only the first shell after boot probes, the rest read the
## cache. Caching is best-effort -- when XDG_RUNTIME_DIR is unset or unwritable
## it simply probes every time.
##
## Pure and strict-mode free, so a caller (unit test, or another script reusing
## the guess) can source this file and call this function without inheriting
## strict-mode. main() owns strict-mode; this function does not.
detect_software_rendering() {
   local cache_file result

   cache_file=""
   if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "${XDG_RUNTIME_DIR}" ]; then
      cache_file="${XDG_RUNTIME_DIR}/detect-software-rendering.cache"
   fi

   result=""
   if [ -n "${cache_file}" ] && [ -r "${cache_file}" ]; then
      result="$(cat -- "${cache_file}")" || result=""
   fi

   if [ -z "${result}" ]; then
      result="$(probe_renderer)"
      if [ -n "${cache_file}" ]; then
         ## Best-effort; a read-only or missing runtime dir must not fail a login.
         printf '%s\n' "${result}" >"${cache_file}" 2>/dev/null || true
      fi
   fi

   printf '%s\n' "${result}"
   case "${result}" in
      software)
         return 0
         ;;
      accelerated)
         return 1
         ;;
      *)
         return 2
         ;;
   esac
}

main() {
   set -o errexit
   set -o nounset
   set -o pipefail
   set -o errtrace
   shopt -s inherit_errexit
   shopt -s shift_verbose

   detect_software_rendering "$@"
}

## Only auto-run when executed, not when sourced (unit tests source it).
if was_executed "${BASH_SOURCE[0]}"; then
   main "$@"
fi
