#!/bin/bash -e

## Copyright (C) 2020 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## errexit on the shebang (direct run only; ignored when sourced) so a failed
## 'source' below aborts before main() sets the full strict block.

## provides was_executed
# shellcheck source=../libexec/helper-scripts/check_runtime.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/check_runtime.bsh
## provides has
# shellcheck source=../libexec/helper-scripts/has.sh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/has.sh

## True if a DRM node ('/dev/dri/renderD*', '/dev/dri/card*') or the NVIDIA
## control node ('/dev/nvidiactl') is present. Both paths are overridable
## (DETECT_SOFTWARE_RENDERING_DRI_DIR, DETECT_SOFTWARE_RENDERING_NVIDIA_CTL) for
## tests. Pure and strict-mode free.
gpu_node_present() {
   local dri_dir nvidia_ctl node

   dri_dir="${DETECT_SOFTWARE_RENDERING_DRI_DIR:-/dev/dri}"
   nvidia_ctl="${DETECT_SOFTWARE_RENDERING_NVIDIA_CTL:-/dev/nvidiactl}"
   for node in "${dri_dir}"/renderD* "${dri_dir}"/card* ; do
      if [ -e "${node}" ]; then
         return 0
      fi
   done
   [ -e "${nvidia_ctl}" ]
}

## Classify the OpenGL renderer. Best-effort only. Prints exactly one word:
## accelerated, software or unknown; anything not a clear match is 'unknown',
## never assumed. Pure and strict-mode free (see detect_software_rendering).
##
## Two zero-cost, hang-free short-circuits run before 'eglinfo', so the common
## no-GPU VM case never spawns a GL probe:
##  - LIBGL_ALWAYS_SOFTWARE truthy: the Mesa stack is forced to llvmpipe.
##  - no DRM node ('/dev/dri/renderD*', '/dev/dri/card*') AND no NVIDIA node
##    ('/dev/nvidiactl'): no hardware driver at all. Proprietary NVIDIA (classic
##    GLX) renders via '/dev/nvidia*', not a DRM node, so its presence blocks
##    this short-circuit and falls through to the probe.
## Only when a GPU node is present is eglinfo asked for the actual renderer.
## eglinfo's GBM/Wayland/device probes FAIL FAST without a DRM node; the one path
## that can block is the X11/Wayland platform connecting to $DISPLAY /
## $WAYLAND_DISPLAY when the server accepts but never replies (a half-started
## server during login), so those are unset for the eglinfo call (the renderer is
## still read via the surfaceless/GBM/device platforms), and it is bounded with
## 'timeout' as a backstop.
probe_renderer() {
   local eglinfo_output renderer_line timeout_maybe

   ## LIBGL_ALWAYS_SOFTWARE forces the Mesa stack to llvmpipe -> software.
   case "${LIBGL_ALWAYS_SOFTWARE:-}" in
      1 | [Tt][Rr][Uu][Ee])
         printf '%s\n' "software"
         return 0
         ;;
   esac

   ## No GPU node -> no hardware driver -> software.
   if ! gpu_node_present ; then
      printf '%s\n' "software"
      return 0
   fi

   eglinfo_output=""
   renderer_line=""
   timeout_maybe=""

   if has eglinfo ; then
      ## 'timeout' (coreutils, Essential: yes) bounds eglinfo; empty prefix when
      ## it is somehow absent, in which case eglinfo runs unbounded.
      if has timeout ; then
         timeout_maybe="timeout 5"
      fi
      ## Deliberate word-splitting: 'timeout 5' -> two words, or nothing. 'env'
      ## unsets DISPLAY/WAYLAND_DISPLAY so eglinfo cannot block on a display-server
      ## connect; the renderer still comes from the surfaceless/GBM/device paths.
      # shellcheck disable=SC2086
      eglinfo_output="$(${timeout_maybe} env --unset=DISPLAY --unset=WAYLAND_DISPLAY eglinfo -B 2>/dev/null)" || true
      renderer_line="$(printf '%s\n' "${eglinfo_output}" | grep --fixed-strings -- "OpenGL core profile renderer:")" || true
   fi

   ## Known hardware vendor renderer -> accelerated. Here-string, not a pipe, so
   ## a quiet grep cannot SIGPIPE the producer into a pipefail failure (R-161).
   if grep --quiet --fixed-strings \
      -e "AMD" \
      -e "NVIDIA" \
      -e "Intel" \
      -e "Apple" \
      -e "Adreno" \
      -e "Radeon" \
      -e "ATI" \
      -e "Mali" \
      -e "Panfrost" \
      -e "V3D" \
      -e "VC4" \
      -e "PowerVR" \
      -e "Vivante" \
      -e "etnaviv" \
      -e "Lima" \
      -e "virgl" \
      -e "SVGA3D" \
      -e "D3D12" \
      <<< "${renderer_line}" ; then
      printf '%s\n' "accelerated"
      return 0
   fi

   if grep --quiet --fixed-strings -- "llvmpipe" <<< "${renderer_line}" ; then
      printf '%s\n' "software"
      return 0
   fi

   printf '%s\n' "unknown"
}

## Best-effort GUESS of the renderer type. Prints one of, and returns:
##   software      0   llvmpipe (mesa CPU renderer)
##   accelerated   1   a known hardware vendor renderer
##   unknown       2   eglinfo absent / empty / timed out / unrecognized
##
## probe_renderer's eglinfo fall-through can cost the full 'timeout' (only reached
## when a GPU node is present), so THAT verdict is cached in the per-user, per-boot
## runtime dir (a tmpfs): the first shell after boot probes, the rest read the
## cache; the cheap no-node short-circuit is not cached (see below). The runtime dir is
## XDG_RUNTIME_DIR, falling back to the canonical '/run/user/<uid>' that logind
## creates when the env var is not propagated -- session-managed but NOT
## GUI-specific (logind sets it for console and ssh sessions too), cleared on
## reboot (correct: the renderer is a per-boot property). The result is encoded
## in the marker-file NAME ('detect-software-rendering.<result>'), so a cache hit
## is a filename test with no file content to read back. Best-effort -- with no
## writable runtime dir it simply probes every time.
##
## Pure and strict-mode free, so a caller (unit test, or another script reusing
## the guess) can source this file and call this function without inheriting
## strict-mode. main() owns strict-mode; this function does not.
detect_software_rendering() {
   local runtime_dir cache_base result guess

   ## Do not cache when LIBGL_ALWAYS_SOFTWARE is set: it is a per-environment
   ## override and the marker name encodes only the result, so a forced-software
   ## marker would wrongly be returned to a later shell that does not set it (and
   ## the reverse). The LIBGL short-circuit is instant, so skipping the cache here
   ## costs nothing.
   runtime_dir="${XDG_RUNTIME_DIR:-/run/user/${UID}}"
   cache_base=""
   if [ -z "${LIBGL_ALWAYS_SOFTWARE:-}" ] \
      && [ -d "${runtime_dir}" ] && [ -w "${runtime_dir}" ]; then
      cache_base="${runtime_dir}/detect-software-rendering"
   fi

   ## Cache HIT is a filename test: the '.<result>' marker present is the answer.
   result=""
   if [ -n "${cache_base}" ]; then
      for guess in software accelerated unknown; do
         if [ -e "${cache_base}.${guess}" ]; then
            result="${guess}"
            break
         fi
      done
   fi

   if [ -z "${result}" ]; then
      result="$(probe_renderer)"
      ## Cache ONLY a verdict that required the eglinfo probe (a GPU node was
      ## present). The no-node short-circuit 'software' is free to recompute and
      ## would go stale if a GPU node appears later this boot: NVIDIA nodes are
      ## created on demand (first GL client), and eGPU/DisplayLink/VM hot-add can
      ## add a '/dev/dri' node. Encode the result in the marker-file NAME;
      ## best-effort, a read-only or missing runtime dir must not fail a login.
      if [ -n "${cache_base}" ] && gpu_node_present ; then
         touch -- "${cache_base}.${result}" 2>/dev/null || true
      fi
   fi

   printf '%s\n' "${result}"
   case "${result}" in
      software)
         return 0
         ;;
      accelerated)
         return 1
         ;;
      *)
         return 2
         ;;
   esac
}

main() {
   set -o errexit
   set -o nounset
   set -o pipefail
   set -o errtrace
   shopt -s inherit_errexit
   shopt -s shift_verbose

   detect_software_rendering "$@"
}

## Only auto-run when executed, not when sourced (unit tests source it).
if was_executed "${BASH_SOURCE[0]}"; then
   main "$@"
fi
