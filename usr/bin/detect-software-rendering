#!/bin/bash -e

## Copyright (C) 2020 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## errexit on the shebang (direct run only; ignored when sourced) so a failed
## 'source' below aborts before main() sets the full strict block.

## provides was_executed
# shellcheck source=../libexec/helper-scripts/check_runtime.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/check_runtime.bsh
## provides has
# shellcheck source=../libexec/helper-scripts/has.sh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/has.sh

## Classify the OpenGL renderer. Best-effort only. Prints exactly one word:
## accelerated, software or unknown; anything not a clear match is 'unknown',
## never assumed. Pure and strict-mode free (see detect_software_rendering).
##
## Two zero-cost, hang-free short-circuits run before 'eglinfo', so the common
## no-GPU VM case never spawns a GL probe:
##  - LIBGL_ALWAYS_SOFTWARE truthy: the Mesa stack is forced to llvmpipe.
##  - no DRM node ('/dev/dri/renderD*', '/dev/dri/card*'): a Mesa stack has no
##    hardware driver. (A proprietary NVIDIA driver without a DRM node is the
##    rare miss; a VM normally has no GPU at all.)
## Only when a DRM node is present is eglinfo asked for the actual renderer.
## eglinfo's GBM/Wayland/device probes FAIL FAST without a DRM node; the one path
## that can block is the X11 platform connecting to $DISPLAY when the X server
## accepts but never replies (a half-started server during login) -- so the
## eglinfo call is still bounded with 'timeout'.
probe_renderer() {
   local dri_dir dri_present node eglinfo_output renderer_line timeout_maybe

   ## LIBGL_ALWAYS_SOFTWARE forces the Mesa stack to llvmpipe -> software.
   case "${LIBGL_ALWAYS_SOFTWARE:-}" in
      1 | [Tt][Rr][Uu][Ee])
         printf '%s\n' "software"
         return 0
         ;;
   esac

   ## No DRM render/card node -> no hardware Mesa driver -> software. The node
   ## directory is overridable (DETECT_SOFTWARE_RENDERING_DRI_DIR) for tests.
   dri_dir="${DETECT_SOFTWARE_RENDERING_DRI_DIR:-/dev/dri}"
   dri_present=""
   for node in "${dri_dir}"/renderD* "${dri_dir}"/card* ; do
      if [ -e "${node}" ]; then
         dri_present="yes"
         break
      fi
   done
   if [ -z "${dri_present}" ]; then
      printf '%s\n' "software"
      return 0
   fi

   eglinfo_output=""
   renderer_line=""
   timeout_maybe=""

   if has eglinfo ; then
      ## 'timeout' (coreutils, Essential: yes) bounds eglinfo; empty prefix when
      ## it is somehow absent, in which case eglinfo runs unbounded.
      if has timeout ; then
         timeout_maybe="timeout 5"
      fi
      ## Deliberate word-splitting: 'timeout 5' -> two words, or nothing.
      # shellcheck disable=SC2086
      eglinfo_output="$(${timeout_maybe} eglinfo -B 2>/dev/null)" || true
      renderer_line="$(printf '%s\n' "${eglinfo_output}" | grep --fixed-strings -- "OpenGL core profile renderer:")" || true
   fi

   ## Known hardware vendor renderer -> accelerated. Here-string, not a pipe, so
   ## a quiet grep cannot SIGPIPE the producer into a pipefail failure (R-161).
   if grep --quiet --fixed-strings \
      -e "AMD" \
      -e "NVIDIA" \
      -e "Intel" \
      -e "Apple" \
      -e "Adreno" \
      -e "Radeon" \
      -e "ATI" \
      -e "Mali" \
      -e "Panfrost" \
      -e "V3D" \
      -e "VC4" \
      -e "PowerVR" \
      -e "Vivante" \
      -e "etnaviv" \
      -e "Lima" \
      -e "virgl" \
      -e "SVGA3D" \
      -e "D3D12" \
      <<< "${renderer_line}" ; then
      printf '%s\n' "accelerated"
      return 0
   fi

   if grep --quiet --fixed-strings -- "llvmpipe" <<< "${renderer_line}" ; then
      printf '%s\n' "software"
      return 0
   fi

   printf '%s\n' "unknown"
}

## Best-effort GUESS of the renderer type. Prints one of, and returns:
##   software      0   llvmpipe (mesa CPU renderer)
##   accelerated   1   a known hardware vendor renderer
##   unknown       2   eglinfo absent / empty / timed out / unrecognized
##
## The renderer is a per-boot property, and probe_renderer's eglinfo fall-through
## can cost the full 'timeout' (only reached when a DRM node is present), so the
## result is cached in XDG_RUNTIME_DIR (a per-boot tmpfs): only the first shell
## after boot probes, the rest read the cache. The result is encoded in the
## marker-file NAME ('detect-software-rendering.<result>'), so a cache hit is a
## filename test with no file content to read back. Caching is best-effort --
## when XDG_RUNTIME_DIR is unset or unwritable it simply probes every time.
##
## Pure and strict-mode free, so a caller (unit test, or another script reusing
## the guess) can source this file and call this function without inheriting
## strict-mode. main() owns strict-mode; this function does not.
detect_software_rendering() {
   local cache_base result guess

   cache_base=""
   if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "${XDG_RUNTIME_DIR}" ]; then
      cache_base="${XDG_RUNTIME_DIR}/detect-software-rendering"
   fi

   ## Cache HIT is a filename test: the '.<result>' marker present is the answer.
   result=""
   if [ -n "${cache_base}" ]; then
      for guess in software accelerated unknown; do
         if [ -e "${cache_base}.${guess}" ]; then
            result="${guess}"
            break
         fi
      done
   fi

   if [ -z "${result}" ]; then
      result="$(probe_renderer)"
      if [ -n "${cache_base}" ]; then
         ## Encode the result in the marker-file NAME; best-effort, a read-only or
         ## missing runtime dir must not fail a login.
         touch -- "${cache_base}.${result}" 2>/dev/null || true
      fi
   fi

   printf '%s\n' "${result}"
   case "${result}" in
      software)
         return 0
         ;;
      accelerated)
         return 1
         ;;
      *)
         return 2
         ;;
   esac
}

main() {
   set -o errexit
   set -o nounset
   set -o pipefail
   set -o errtrace
   shopt -s inherit_errexit
   shopt -s shift_verbose

   detect_software_rendering "$@"
}

## Only auto-run when executed, not when sourced (unit tests source it).
if was_executed "${BASH_SOURCE[0]}"; then
   main "$@"
fi
